# health-coach - copy to .env and fill in values

# --- Auth ---
APP_PASSWORD=changeme

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Garmin ---
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password
GARMIN_INITIAL_DAYS=90

# --- Withings (register app at developer.withings.com) ---
# Redirect URI: http://localhost:8000/api/withings/callback
# Scopes: user.metrics
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# --- Fitatu ---
FITATU_EMAIL=you@fitatu.com
FITATU_PASSWORD=your_fitatu_password

# --- Ollama (lokalny LLM - fallback gdy brak ANTHROPIC_API_KEY) ---
# Domyslnie: http://localhost:11434
# Model domyslny: qwen2.5:14b (zmien w Ustawieniach)
OLLAMA_BASE_URL=http://localhost:11434
